{
  "name": "dsh-dqd-scroll",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness 懂球帝阅读插件。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "config.toml",
    "teams.json",
    "client.js",
    "cordis.patch.yml",
    "docs/api-contract.md",
    "fixtures/README.md",
    "fixtures/*.json",
    "index.js",
    "prompts/duty.md",
    "pyproject.toml",
    "README.md",
    "settings-api.js",
    "src/dqd_scroll/*.py",
    "src/dqd_scroll/api/*.py",
    "src/dqd_scroll/lib/*.py",
    "tools/README.md",
    "tools/*.ps1"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
