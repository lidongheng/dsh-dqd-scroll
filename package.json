{
  "name": "dsh-dqd-scroll",
  "version": "0.3.0",
  "description": "DeepSeek Harness 懂球帝阅读插件。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dongqiudi",
    "football",
    "daily-report"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lidongheng/dsh-dqd-scroll.git"
  },
  "homepage": "https://github.com/lidongheng/dsh-dqd-scroll#readme",
  "bugs": {
    "url": "https://github.com/lidongheng/dsh-dqd-scroll/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "config.toml",
    "teams.json",
    "client.js",
    "cordis.patch.yml",
    "docs/api-contract.md",
    "environment.yml",
    "fixtures/README.md",
    "fixtures/*.json",
    "index.js",
    "prompts/duty.md",
    "pyproject.toml",
    "README.md",
    "settings-api.js",
    "lib/logger.js",
    "lib/scheduler.js",
    "lib/dynamics-report-time.mjs",
    "lib/dynamics-scheduled-runner.js",
    "lib/uvfetch.mjs",
    "lib/user-data.js",
    "src/dqd_scroll/*.py",
    "src/dqd_scroll/api/*.py",
    "src/dqd_scroll/lib/*.py"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --test"
  }
}
